<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Logique de l'appli (réglages, sauvegarde, journal, powercfg).
    En net8.0 « simple » pour que les tests tournent aussi sous Linux : tout ce qui touche
    Windows passe par de petites interfaces, remplacées par des fausses versions dans les tests.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Unpark.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- WMI (points de restauration, infos système). Fonctionne seulement sous Windows. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- Arrêt/relance propre de Windows Update pendant le nettoyage. Fonctionne seulement sous Windows. -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Unpark.Tests" />
  </ItemGroup>
</Project>
