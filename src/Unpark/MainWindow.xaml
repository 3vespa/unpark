<Window x:Class="Unpark.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Unpark.ViewModels"
        Title="{Binding WindowTitle}"
        Width="1100" Height="720" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Menu de gauche -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,24,16,16">
                <StackPanel DockPanel.Dock="Top" Margin="8,0,0,24">
                    <TextBlock Text="{Binding AppName}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Version}" Margin="8,12,0,0" FontSize="12" Foreground="{StaticResource TextDimBrush}" />
                <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="16" Width="28" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Page affichée, avec le bandeau de redémarrage au-dessus -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="{StaticResource WarnBrush}" Padding="20,10"
                    Visibility="{Binding RestartNeeded, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Redémarrer maintenant" Command="{Binding RestartNowCommand}" Padding="14,6" />
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="#1A1200" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding RestartText}" Foreground="#1A1200" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ContentControl Content="{Binding SelectedPage}" Margin="36,32" />
            </ScrollViewer>
        </DockPanel>

        <!-- Opération en cours : bloque l'appli le temps qu'elle se termine -->
        <Grid Grid.ColumnSpan="2" Background="#C0000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="360">
                <StackPanel>
                    <TextBlock Text="{Binding BusyText}" Style="{StaticResource BodyText}" HorizontalAlignment="Center" TextAlignment="Center" />
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,16,0,0" Foreground="{StaticResource AccentBrush}"
                                 Background="{StaticResource BorderBrush}" BorderThickness="0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
