<Application x:Class="Unpark.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Unpark.ViewModels"
             xmlns:v="clr-namespace:Unpark.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Chaque page (ViewModel) s'affiche avec sa vue. -->
            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <v:HomeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PowerPlanViewModel}">
                <v:PowerPlanView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GamingViewModel}">
                <v:GamingView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StartupViewModel}">
                <v:StartupView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CleanupViewModel}">
                <v:CleanupView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
                <v:PlaceholderView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
