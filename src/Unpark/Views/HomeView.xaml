<UserControl x:Class="Unpark.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="{Binding Welcome}" Style="{StaticResource TitleText}" />
        <TextBlock Text="Optimise ton PC pour le jeu, sans rien casser : chaque réglage s'annule en un clic."
                   Style="{StaticResource DimText}" Margin="0,6,0,0" />

        <Border Style="{StaticResource Card}" Margin="0,24,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Administrateur" Style="{StaticResource DimText}" />
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource AccentBrush}" Margin="0,2,8,0"
                               Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding AdminText}" Style="{StaticResource BodyText}" />
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Windows" Style="{StaticResource DimText}" Margin="0,12,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding WindowsVersion}" Style="{StaticResource BodyText}" Margin="0,12,0,0" />
            </Grid>
        </Border>

        <!-- Sauvegarde illisible au démarrage -->
        <Border Style="{StaticResource Card}" Margin="0,16,0,0" BorderBrush="{StaticResource DangerBrush}"
                Visibility="{Binding HasBackupWarning, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding BackupWarning}" Style="{StaticResource BodyText}" Foreground="{StaticResource DangerBrush}" />
        </Border>

        <!-- Sécurité -->
        <TextBlock Text="Sécurité" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,28,0,0" />
        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="{Binding RestorePointText}" Style="{StaticResource BodyText}" />
                <TextBlock Style="{StaticResource DimText}" Margin="0,4,0,0"
                           Text="Un point de restauration permet de remettre Windows dans l'état d'avant, même si Unpark ne s'ouvre plus." />
                <Button Content="Créer un point de restauration" Command="{Binding CreateRestorePointCommand}"
                        HorizontalAlignment="Left" Margin="0,14,0,0" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="{Binding ActiveChangesText}" Style="{StaticResource BodyText}" />
                <WrapPanel Margin="0,14,0,0">
                    <Button Content="Tout annuler" Command="{Binding RevertAllCommand}" Margin="0,0,10,0" />
                    <Button Content="Ouvrir les journaux" Command="{Binding OpenLogsCommand}" Margin="0,0,10,0" />
                    <Button Content="Ouvrir le dossier de sauvegarde" Command="{Binding OpenBackupFolderCommand}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Mises à jour -->
        <TextBlock Text="Mises à jour" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,28,0,0" />
        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <CheckBox IsChecked="{Binding AutoUpdate}">
                    <TextBlock Text="Mettre à jour Unpark automatiquement" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                </CheckBox>
                <TextBlock Style="{StaticResource DimText}" Margin="0,8,0,0"
                           Text="Au démarrage, Unpark regarde s'il existe une nouvelle version sur GitHub (3vespa/unpark), la télécharge en arrière-plan, puis l'installe quand tu cliques sur « Redémarrer maintenant » ou à la prochaine ouverture. Chaque mise à jour est vérifiée (signature et empreinte) avant d'être installée ; tes réglages et la sauvegarde « Tout annuler » sont conservés. Décoché : Unpark ne se connecte plus à GitHub, tu télécharges les nouvelles versions toi-même." />
                <TextBlock Text="{Binding VersionText}" Style="{StaticResource DimText}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
