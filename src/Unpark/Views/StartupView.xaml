<UserControl x:Class="Unpark.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Actualiser" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
            <TextBlock Text="Démarrage" Style="{StaticResource TitleText}" />
        </DockPanel>
        <TextBlock Style="{StaticResource DimText}" Margin="0,6,0,0"
                   Text="Moins de programmes au démarrage = Windows prêt plus vite et moins de choses en arrière-plan pendant le jeu. Désactiver ne supprime rien : comme dans le Gestionnaire des tâches, le programme ne se lance simplement plus tout seul." />
        <TextBlock Text="{Binding Summary}" Style="{StaticResource BodyText}" Margin="0,16,0,12" />
        <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{Binding Source}" Style="{StaticResource DimText}" FontSize="12" />
                                <TextBlock Text="{Binding Command}" Style="{StaticResource DimText}" FontSize="11" TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" ToolTip="{Binding Command}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding StateText}" VerticalAlignment="Center" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="2" Content="{Binding ButtonText}" Command="{Binding ToggleCommand}" MinWidth="110" Padding="12,8" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
