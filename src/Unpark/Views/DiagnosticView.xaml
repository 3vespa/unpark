<UserControl x:Class="Unpark.Views.DiagnosticView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Copier le rapport" Command="{Binding CopyReportCommand}" Margin="0,0,10,0"
                        IsEnabled="{Binding HasResult}" />
                <Button Content="Lancer le diagnostic" Style="{StaticResource AccentButton}" Command="{Binding RunCommand}" />
            </StackPanel>
            <TextBlock Text="Diagnostic" Style="{StaticResource TitleText}" />
        </DockPanel>
        <TextBlock Style="{StaticResource DimText}" Margin="0,6,0,0"
                   Text="Vérifie en environ 40 secondes ce qui peut freiner ton PC en jeu : mémoire, écran, carte graphique, erreurs, disques, Windows et réseau. Lecture seule : rien n'est modifié." />

        <!-- Résumé -->
        <Border Style="{StaticResource Card}" Margin="0,20,0,0" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource BodyText}" FontSize="16" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="●" Foreground="{StaticResource DangerBrush}" FontSize="16" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding RedCount, StringFormat={}{0} problème(s)}" Style="{StaticResource BodyText}" Margin="0,0,20,0" />
                    <TextBlock Text="●" Foreground="{StaticResource WarnBrush}" FontSize="16" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding OrangeCount, StringFormat={}{0} à vérifier}" Style="{StaticResource BodyText}" Margin="0,0,20,0" />
                    <TextBlock Text="●" Foreground="{StaticResource AccentBrush}" FontSize="16" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding GreenCount, StringFormat={}{0} OK}" Style="{StaticResource BodyText}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Sections -->
        <ItemsControl ItemsSource="{Binding Sections}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,24,0,10" />
                        <ItemsControl ItemsSource="{Binding Checks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="●" FontSize="18" VerticalAlignment="Top" Margin="0,-2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource InfoBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Green">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Orange">
                                                                <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Red">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                                <WrapPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding Value}" Style="{StaticResource BodyText}" Foreground="{StaticResource TextBrush}" Opacity="0.85" />
                                                </WrapPanel>
                                                <TextBlock Text="{Binding Explanation}" Style="{StaticResource DimText}" FontSize="12" Margin="0,4,0,0" />
                                                <!-- Guide XMP / EXPO dépliable, sur la ligne même -->
                                                <Border Margin="0,12,0,0" Padding="14,12" CornerRadius="8" Background="{StaticResource BgBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                        Visibility="{Binding IsGuideOpen, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Guide.Title}" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                                        <ItemsControl ItemsSource="{Binding Guide.Steps}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding}" Style="{StaticResource BodyText}" FontSize="13" Margin="0,0,0,6" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <DockPanel Margin="0,6,0,0">
                                                            <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource WarnBrush}" Margin="0,2,8,0" />
                                                            <TextBlock Text="{Binding Guide.Note}" Style="{StaticResource BodyText}" FontSize="13" Foreground="{StaticResource WarnBrush}" />
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                                <Button Content="{Binding FixText}" Command="{Binding FixCommand}" Padding="12,6"
                                                        Visibility="{Binding HasFix, Converter={StaticResource BoolToVis}}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAccentFix}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                                    <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="{Binding GuideButtonText}" Command="{Binding ToggleGuideCommand}" Padding="12,6"
                                                        Visibility="{Binding HasGuide, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
