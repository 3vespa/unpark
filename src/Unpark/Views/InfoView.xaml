<UserControl x:Class="Unpark.Views.InfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Copier le résumé" Command="{Binding CopyCommand}" Margin="0,0,10,0" />
                <Button Content="Actualiser" Command="{Binding RefreshCommand}" />
            </StackPanel>
            <TextBlock Text="Infos système" Style="{StaticResource TitleText}" />
        </DockPanel>
        <TextBlock Text="{Binding Status}" Style="{StaticResource DimText}" Margin="0,8,0,0"
                   Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}" />

        <Border Style="{StaticResource Card}" Margin="0,20,0,0">
            <ItemsControl ItemsSource="{Binding Lines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource DimText}" />
                            <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource BodyText}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <TextBlock Text="Espace disque" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,28,0,12" />
        <ItemsControl ItemsSource="{Binding Volumes}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Style="{StaticResource DimText}" />
                                <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                            </DockPanel>
                            <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,8,0,0"
                                         Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" BorderThickness="0" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
