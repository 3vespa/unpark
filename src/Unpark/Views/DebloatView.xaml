<UserControl x:Class="Unpark.Views.DebloatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Debloat" Style="{StaticResource TitleText}" />
        <TextBlock Style="{StaticResource DimText}" Margin="0,6,0,0"
                   Text="Rangement : quasi aucun effet sur les FPS, car ces applis ne tournent pas (sauf quelques-unes en fond, comme Widgets ou Teams). Retrait pour ton compte Windows seulement ; réinstallation possible depuis le Microsoft Store." />
        <WrapPanel Margin="0,20,0,0">
            <Button Content="Lister les applis" Command="{Binding LoadCommand}" Margin="0,0,10,0" />
            <Button Content="Retirer la sélection" Style="{StaticResource AccentButton}" Command="{Binding RemoveCommand}" IsEnabled="{Binding Loaded}" />
        </WrapPanel>
        <TextBlock Text="{Binding Summary}" Style="{StaticResource DimText}" Margin="0,16,0,12" />

        <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="16,10" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{Binding PackageName}" Style="{StaticResource DimText}" FontSize="11" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding PolicyText}" VerticalAlignment="Center" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Recommended}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Applis retirées par Unpark" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,28,0,12" />
            <ItemsControl ItemsSource="{Binding History}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16,10" Margin="0,0,0,6">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Réinstaller (Store)" Command="{Binding OpenStoreCommand}" Padding="12,6" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="14" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="{Binding When}" Style="{StaticResource DimText}" FontSize="11" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
