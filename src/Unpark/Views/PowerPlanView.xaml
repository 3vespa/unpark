<UserControl x:Class="Unpark.Views.PowerPlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Plan d'alimentation" Style="{StaticResource TitleText}" />
        <TextBlock Style="{StaticResource DimText}" Margin="0,6,0,0"
                   Text="« Unpark Performance » garde tous les cœurs du processeur actifs et prêts à pleine vitesse. Gain réel mais modeste : surtout de meilleurs 1 % low dans les jeux limités par le processeur ; souvent nul si c'est la carte graphique qui limite." />

        <!-- Erreur de lecture -->
        <Border Style="{StaticResource Card}" Margin="0,16,0,0" BorderBrush="{StaticResource DangerBrush}"
                Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}">
            <TextBlock Text="{Binding Error}" Style="{StaticResource BodyText}" Foreground="{StaticResource DangerBrush}" />
        </Border>

        <!-- Avertissement portable -->
        <Border Style="{StaticResource Card}" Margin="0,16,0,0" BorderBrush="{StaticResource WarnBrush}"
                Visibility="{Binding IsLaptop, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{StaticResource WarnBrush}" Margin="0,2,12,0" VerticalAlignment="Top" />
                <TextBlock Style="{StaticResource BodyText}" MaxWidth="680"
                           Text="Portable détecté : le plan chauffe davantage le PC sur secteur. Sur batterie, il garde les réglages du plan Équilibré pour préserver l'autonomie." />
            </StackPanel>
        </Border>

        <!-- État et boutons -->
        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="{Binding ActiveText}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding UnparkText}" Style="{StaticResource DimText}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding PreviousText}" Style="{StaticResource DimText}" Margin="0,2,0,0" />
                <WrapPanel Margin="0,16,0,0">
                    <Button Content="Installer et activer" Style="{StaticResource AccentButton}" Command="{Binding InstallCommand}" Margin="0,0,10,8" />
                    <Button Content="Revenir à mon ancien plan" Command="{Binding SwitchBackCommand}" Margin="0,0,10,8"
                            IsEnabled="{Binding UnparkActive}" />
                    <Button Content="Supprimer le plan Unpark" Command="{Binding RemoveCommand}" Margin="0,0,10,8"
                            IsEnabled="{Binding Installed}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Réglages -->
        <TextBlock Text="Ce que le plan règle" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,28,0,0" />
        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="20,12">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource BodyText}" />
                            <TextBlock Grid.Column="1" Text="{Binding Target}" Style="{StaticResource BodyText}" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Grid.Column="2" Text="{Binding Current, StringFormat=Actuel : {0}}" Style="{StaticResource DimText}" />
                            <TextBlock Grid.Column="3" Text="{Binding StateIcon}" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Ok}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <TextBlock Style="{StaticResource DimText}" Margin="0,10,0,0" FontSize="12"
                   Text="Valeurs « sur secteur ». Les réglages « cœurs efficaces » n'apparaissent que sur les processeurs Intel hybrides (12e génération et plus)." />
    </StackPanel>
</UserControl>
