<UserControl x:Class="Unpark.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource TitleText}" />
        <Border Style="{StaticResource Card}" Margin="0,20,0,0">
            <StackPanel>
                <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}" />
                <TextBlock Text="Bientôt disponible." Style="{StaticResource DimText}" Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
