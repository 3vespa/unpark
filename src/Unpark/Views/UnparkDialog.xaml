<Window x:Class="Unpark.Views.UnparkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unpark"
        Width="500" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI" UseLayoutRounding="True">
    <!-- Marge transparente : laisse la place à l'ombre. -->
    <Border x:Name="Root" Margin="16" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="12" MouseLeftButtonDown="OnDrag">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <DockPanel Margin="24,22,24,20">
            <!-- En-tête : icône + « Unpark » -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock x:Name="IconGlyph" FontFamily="{StaticResource IconFont}" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Text="Unpark" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Boutons -->
            <StackPanel x:Name="ButtonsPanel" DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0" />

            <!-- Message (défile s'il est long, ex. la liste de « Tout annuler ») -->
            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" Focusable="False">
                <TextBlock x:Name="MessageText" Style="{StaticResource BodyText}" LineHeight="20" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
