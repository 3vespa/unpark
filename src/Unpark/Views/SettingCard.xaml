<UserControl x:Class="Unpark.Views.SettingCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Carte d'un réglage réversible (DataContext : SettingItemViewModel) -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <WrapPanel>
                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,10,0" />
                    <Border Background="{StaticResource WarnBrush}" CornerRadius="4" Padding="6,1" Margin="0,2,6,0"
                            Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Redémarrage requis" FontSize="11" FontWeight="SemiBold" Foreground="#1A1200" />
                    </Border>
                </WrapPanel>
                <TextBlock Text="{Binding Description}" Style="{StaticResource DimText}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding Note}" Style="{StaticResource BodyText}" Foreground="{StaticResource WarnBrush}" FontSize="12" Margin="0,4,0,0"
                           Visibility="{Binding Note, Converter={StaticResource NullToCollapsed}}" />
                <Expander Header="Voir ce qui change" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,0"
                          Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Preview}" Margin="18,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource DimText}" FontSize="12" Margin="0,1">
                                    <Run Text="{Binding Label, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                                    <Run Text=" : " />
                                    <Run Text="{Binding State, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="170">
                <TextBlock Text="{Binding StatusText}" FontSize="12" HorizontalAlignment="Right" Margin="0,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Appliquer" Style="{StaticResource AccentButton}" Command="{Binding ApplyCommand}" Padding="14,8" Margin="0,0,8,0" />
                    <Button Content="Annuler" Command="{Binding RevertCommand}" Padding="14,8" IsEnabled="{Binding HasBackup}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
