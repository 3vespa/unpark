<UserControl x:Class="Unpark.Views.OneClickView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Gaming en 1 clic" Style="{StaticResource TitleText}" />
        <TextBlock Style="{StaticResource DimText}" Margin="0,6,0,0"
                   Text="Applique d'un coup le plan Unpark Performance et les réglages Gaming, puis propose un nettoyage. Un récapitulatif s'affiche avant de valider." />

        <!-- Avertissement portable -->
        <Border Style="{StaticResource Card}" Margin="0,16,0,0" BorderBrush="{StaticResource WarnBrush}"
                Visibility="{Binding IsLaptop, Converter={StaticResource BoolToVis}}">
            <TextBlock Style="{StaticResource BodyText}"
                       Text="Portable détecté : le plan Unpark chauffe davantage le PC sur secteur. Sur batterie, il garde les réglages du plan Équilibré." />
        </Border>

        <!-- Gros boutons -->
        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <WrapPanel>
                    <Button Content="Tout appliquer" Style="{StaticResource AccentButton}" Command="{Binding ApplyCommand}"
                            FontSize="16" Padding="28,12" Margin="0,0,12,8" />
                    <Button Content="Tout annuler" Command="{Binding RevertAllCommand}" FontSize="16" Padding="28,12" Margin="0,0,12,8" />
                </WrapPanel>
                <CheckBox IsChecked="{Binding ProposeCleanup}" Margin="0,8,0,0">
                    <TextBlock Text="Proposer le nettoyage à la fin" Style="{StaticResource BodyText}" />
                </CheckBox>
                <TextBlock Text="{Binding ActiveChangesText}" Style="{StaticResource DimText}" Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- Récapitulatif -->
        <TextBlock Text="Ce qui va être fait" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,28,0,12" />
        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <WrapPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,8,0" />
                                    <Border Background="{StaticResource WarnBrush}" CornerRadius="4" Padding="6,1" Margin="0,2,0,0"
                                            Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Redémarrage requis" FontSize="11" FontWeight="SemiBold" Foreground="#1A1200" />
                                    </Border>
                                </WrapPanel>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource DimText}" FontSize="12" />
                                <TextBlock Text="{Binding Note}" Style="{StaticResource BodyText}" Foreground="{StaticResource WarnBrush}" FontSize="12"
                                           Visibility="{Binding Note, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding StateText}" VerticalAlignment="Center" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AlreadyApplied}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
