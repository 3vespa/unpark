<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041 : donne accès aux API Windows (ex. gestion des applis pour le Debloat). Windows 10 22H2 = build 19045. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Seulement pour l'icône de la zone de notification (NotifyIcon) du mode dynamique. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- La gestion DPI passe par app.manifest (WPF) : l'avertissement WinForms correspondant ne s'applique pas. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- Permet de compiler une appli Windows depuis Linux. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Unpark</AssemblyName>
    <RootNamespace>Unpark</RootNamespace>
    <!-- requireAdministrator : l'appli demande les droits admin au lancement. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Icône de l'exe (générée par scripts/make-icons.py à partir du logo). -->
    <ApplicationIcon>Assets\Unpark.ico</ApplicationIcon>
    <NeutralLanguage>fr-FR</NeutralLanguage>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Publication : un seul .exe autonome (rien à installer chez tes potes). Utilisé par build.sh. -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <!-- WPF ne supporte pas le « trimming » (suppression du code inutilisé). -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pas d'espaces de noms WinForms implicites : évite les conflits avec WPF (Application, MessageBox…). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Unpark.Core\Unpark.Core.csproj" />
  </ItemGroup>
</Project>
